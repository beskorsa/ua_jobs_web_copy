# Скопировать в .env.local (для локальной разработки) и/или прописать в
# Vercel → Project Settings → Environment Variables (для деплоя).

# ВАЖНО: та же Postgres/Supabase база, что использует ua_jobs_parser
# (Python-скрейпер + generate.py). Веб-часть на Vercel — serverless Node,
# локальные embedding-модели (sentence-transformers) там гонять нельзя,
# поэтому эмбеддинги здесь ВСЕГДА через OpenAI API (1536-мерные,
# text-embedding-3-small). Если vacancy_chunks в базе были насчитаны с
# EMBEDDING_PROVIDER=local (384-мерные, дефолт в ua_jobs_parser/.env) —
# семантический поиск с этого сайта работать НЕ будет (несовпадение
# размерности вектора). Перед первым запуском веб-части убедитесь, что
# ua_jobs_parser/sync_supabase.py гонялся с EMBEDDING_PROVIDER=openai
# (пересоздать: EMBEDDING_PROVIDER=openai python sync_supabase.py).
DATABASE_URL=postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

OPENAI_API_KEY=sk-proj-your-key-here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
